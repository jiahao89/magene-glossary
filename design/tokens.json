      "primary": { "$value": "0 0 24px -2px rgba(249, 115, 22, 0.45)", "$type": "shadow" },
      "accent": { "$value": "0 0 24px -2px rgba(6, 182, 212, 0.45)", "$type": "shadow" },
      "danger": { "$value": "0 0 28px -2px rgba(244, 63, 94, 0.55)", "$type": "shadow" }
