# ====================================
# GlossaHub 环境变量配置模板
# ====================================
# 复制此文件为 .env 并填写实际值

# ---- 后端数据库 (server.cjs) ----
# 妙搭 (MiaoDa) / 云端 PostgreSQL 数据库连接串
# 本地开发留空则自动使用本地 SQLite (glossahub.db)
# 妙搭/Supabase/PostgreSQL 格式:
# postgresql://user:password@host:5432/dbname
DATABASE_URL=

# 一键初始化/自检云端数据库命令:
# npm run db:init:pg

# JWT 密钥 (生产环境必填，建议 32+ 位随机字符串)
# 生成方法: openssl rand -hex 32
JWT_SECRET=

# ---- 多引擎 AI 翻译配置 (支持大模型直连 / Dify / 本地离线词典) ----
# AI 模式选择: openai (推荐大模型直连) | dify (Dify工作流) | local (纯离线词典)
AI_PROVIDER=openai

# 1. 大模型直连 (推荐 DeepSeek-V3 / 阿里通义千问 / OpenAI)
# DeepSeek 预设:
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 阿里通义千问兼容预设 (可选):
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL=qwen-plus
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 2. Dify 翻译引擎配置 (传统模式，作为备用方案)
# DIFY_BASE_URL=https://api.dify.ai/v1
# DIFY_API_KEY=app-xxxxxxxxxxxx

# 内置 Dify 引擎 Key 列表 (逗号分隔; 顺序对应内置引擎域名: night.magene.cn, api.dify.ai)
DIFY_BUILTIN_KEYS=app-xxxx,app-yyyy

# CORS 白名单 (逗号分隔，填入前端域名)
# 本地开发: http://localhost:5173
# 生产部署: https://your-app.example.com
CORS_ORIGINS=http://localhost:5173

# 服务端口 (妙搭 / Render 会自动注入 PORT)
PORT=3001

# ---- 前端 (Vite) ----
# 后端 API 地址 (仅独立前后端部署生产环境需要配置)
# 本地开发留空 (走 Vite proxy)
VITE_API_BASE_URL=
